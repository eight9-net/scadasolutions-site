    {
      "id": "de_body",
      "type": "text",
      "x": 16,
      "y": 210,
      "width": 688,
      "height": 116,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 126,
      "version": 1,
      "versionNonce": 127,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Our team of skilled engineers and designers is ready to support you with your\ndesign and engineering requirements. We provide detailed, expert programming\ntailored to meet your specific requests and needs. This encompasses identifying\nthe right components and disciplines for integration, determining configuration\ndetails and installation specifications, and guaranteeing utmost efficiency\nand effectiveness of the final product.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our team of skilled engineers and designers is ready to support you with your\ndesign and engineering requirements. We provide detailed, expert programming\ntailored to meet your specific requests and needs. This encompasses identifying\nthe right components and disciplines for integration, determining configuration\ndetails and installation specifications, and guaranteeing utmost efficiency\nand effectiveness of the final product.",
      "lineHeight": 1.4
    },
