    },
    {
      "id": "solar_body",
      "type": "text",
      "x": 200,
      "y": 1676,
      "width": 1040,
      "height": 97,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
