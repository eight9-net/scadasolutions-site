    {
      "id": "svc_body",
      "type": "text",
      "x": 200,
      "y": 596,
      "width": 1040,
      "height": 116,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 144,
      "version": 1,
      "versionNonce": 145,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Service and support at SCADA Solutions never end. We offer aggressive warranties with all our products\nand installations. Any problems that impact system availability are given immediate priority and responded\nto on the same day. Any non-critical problems are acknowledged within one day and followed up within 48h.\nOur product service plans are an affordable way to ensure you're optimizing your critical infrastructure\nassets. We provide detailed training for staff and supply easy-to-use manuals. Software upgrades are done\nseamlessly. Please Contact Us or call us to speak with a solutions expert.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Service and support at SCADA Solutions never end. We offer aggressive warranties with all our products\nand installations. Any problems that impact system availability are given immediate priority and responded\nto on the same day. Any non-critical problems are acknowledged within one day and followed up within 48h.\nOur product service plans are an affordable way to ensure you're optimizing your critical infrastructure\nassets. We provide detailed training for staff and supply easy-to-use manuals. Software upgrades are done\nseamlessly. Please Contact Us or call us to speak with a solutions expert.",
      "lineHeight": 1.4
    },
