      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "WindCapture™ offers an unprecedented level of automation. Automated curtailment\neasily handles curtailment setpoints from the power-outtaker, or CAISO.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WindCapture™ offers an unprecedented level of automation. Automated curtailment\neasily handles curtailment setpoints from the power-outtaker, or CAISO.",
      "lineHeight": 1.4
    },
