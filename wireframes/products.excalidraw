    },
    {
      "id": "sow3_body",
      "type": "text",
      "x": 80,
      "y": 6056,
      "width": 1280,
      "height": 79,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 398,
      "version": 1,
      "versionNonce": 399,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Wherever applicable, and usually whenever possible, we will simulate as much as practical off site. We will set up\nall software and hardware components, mount and/or connect all equipment, communication cabling, fiber optics,\nradios, etc., and coordinate any ancillary needs from the client. We will then conduct off-site acceptance tests of\nthe installation prior to start up. Acceptance test periods will vary depending on the complexity of the design.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wherever applicable, and usually whenever possible, we will simulate as much as practical off site. We will set up\nall software and hardware components, mount and/or connect all equipment, communication cabling, fiber optics,\nradios, etc., and coordinate any ancillary needs from the client. We will then conduct off-site acceptance tests of\nthe installation prior to start up. Acceptance test periods will vary depending on the complexity of the design.",
      "lineHeight": 1.4
    },
