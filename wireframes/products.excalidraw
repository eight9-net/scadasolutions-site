      "versionNonce": 133,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Scalability",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scalability",
      "lineHeight": 1.4
    },
    {
      "id": "scada_s1_b4",
      "type": "text",
      "x": 16,
      "y": 652,
      "width": 688,
      "height": 61,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 134,
      "version": 1,
      "versionNonce": 135,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "WindCapture™ is engineered to handle any number of turbines and is easily upgraded\nto sustain any future growth. SSI can connect your projects and various farms together.\nDesign platforms support projects with several different types of turbines.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WindCapture™ is engineered to handle any number of turbines and is easily upgraded\nto sustain any future growth. SSI can connect your projects and various farms together.\nDesign platforms support projects with several different types of turbines.",
      "lineHeight": 1.4
    },
    {
      "id": "scada_h4_report",
      "type": "text",
