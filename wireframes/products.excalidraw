      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Seamless SCADA Solutions for Uninterrupted Operations",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Seamless SCADA Solutions for Uninterrupted Operations",
      "lineHeight": 1.4
    },
    {
      "id": "scada_s1_b1",
      "type": "text",
      "x": 16,
      "y": 392,
      "width": 688,
      "height": 97,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 126,
      "version": 1,
      "versionNonce": 127,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "SCADA Solutions' flagship product, WindCapture™, is a Supervisory Control and Data\nAcquisition (SCADA) software package used for monitoring, controlling, data collection,\nand reporting for wind turbine generators (WTG). It was designed and tailored to the\ndemands of manufacturers, operators, developers, and maintenance managers of wind\nenergy projects and facilities.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SCADA Solutions' flagship product, WindCapture™, is a Supervisory Control and Data\nAcquisition (SCADA) software package used for monitoring, controlling, data collection,\nand reporting for wind turbine generators (WTG). It was designed and tailored to the\ndemands of manufacturers, operators, developers, and maintenance managers of wind\nenergy projects and facilities.",
      "lineHeight": 1.4
    },
    {
      "id": "scada_s1_b2",
      "type": "text",
      "x": 16,
      "y": 502,
      "width": 688,
      "height": 79,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 128,
      "version": 1,
      "versionNonce": 129,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Regardless of the make of turbines in your project(s), SSI customizes WindCapture™ with\nevery installation to ensure the reliable flow and presentation of needed data. The system\nalso combines a comprehensive database management system for standardized and\ncustomized operations reports with powerful analytic graphs, charts, tables, and other tools.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Regardless of the make of turbines in your project(s), SSI customizes WindCapture™ with\nevery installation to ensure the reliable flow and presentation of needed data. The system\nalso combines a comprehensive database management system for standardized and\ncustomized operations reports with powerful analytic graphs, charts, tables, and other tools.",
      "lineHeight": 1.4
    },
    {
      "id": "scada_s1_b3",
      "type": "text",
      "x": 16,
      "y": 592,
      "width": 688,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 130,
      "version": 1,
      "versionNonce": 131,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "WindCapture™ has numerous usable, integrated functions. Key features include:",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WindCapture™ has numerous usable, integrated functions. Key features include:",
      "lineHeight": 1.4
    },
    {
      "id": "scada_h4_scale",
      "type": "text",
      "x": 16,
      "y": 626,
      "width": 688,
      "height": 27,
      "angle": 0,
      "strokeColor": "#1f2937",
