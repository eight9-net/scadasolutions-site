    {
      "id": "sow4_body",
      "type": "text",
      "x": 80,
      "y": 6342,
      "width": 1280,
      "height": 97,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
