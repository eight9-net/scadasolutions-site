    {
      "id": "comm_fo_b1",
      "type": "text",
      "x": 80,
      "y": 4164,
      "width": 1280,
      "height": 61,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 308,
      "version": 1,
      "versionNonce": 309,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "SCADA Solutions is a leader in the application of cutting-edge fiber optic terminations and splicing\nmethods. Our Applications Specialists can help you select the right component for each step in the\ntermination and assembly process.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SCADA Solutions is a leader in the application of cutting-edge fiber optic terminations and splicing\nmethods. Our Applications Specialists can help you select the right component for each step in the\ntermination and assembly process.",
      "lineHeight": 1.4
    },
    {
      "id": "comm_fo_b2",
      "type": "text",
      "x": 80,
      "y": 4228,
      "width": 1280,
      "height": 43,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 310,
      "version": 1,
      "versionNonce": 311,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Customers have confidence that every assembly has been manufactured to your exact specifications\nusing brand-name products, fully tested to international industry standards.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Customers have confidence that every assembly has been manufactured to your exact specifications\nusing brand-name products, fully tested to international industry standards.",
      "lineHeight": 1.4
    },
