      "lineHeight": 1.4
    },
    {
      "id": "comm_ae_body",
      "type": "text",
      "x": 16,
      "y": 3742,
      "width": 688,
      "height": 116,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 290,
      "version": 1,
      "versionNonce": 291,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Our highly qualified applications engineers are experts in the application of fiber optic\nmedia, cables, connectors, and hardware. No matter how complex or challenging your requirements,\nour team can develop a custom solution that's reliable, mitigates risk, and helps speed up\nproject implementation schedules. SCADA Solutions' engineers are skilled at designing the\nmost advanced single- and multi-mode cable assemblies, guaranteeing to meet even the most\nstringent connector and cable specifications.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our highly qualified applications engineers are experts in the application of fiber optic\nmedia, cables, connectors, and hardware. No matter how complex or challenging your requirements,\nour team can develop a custom solution that's reliable, mitigates risk, and helps speed up\nproject implementation schedules. SCADA Solutions' engineers are skilled at designing the\nmost advanced single- and multi-mode cable assemblies, guaranteeing to meet even the most\nstringent connector and cable specifications.",
      "lineHeight": 1.4
    },
