    {
      "id": "scada_s1_b5",
      "type": "text",
      "x": 16,
      "y": 746,
      "width": 688,
      "height": 61,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 138,
      "version": 1,
      "versionNonce": 139,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "SSI's WindCapture™ systems provide real-time reporting with the highest degree of\naccuracy. Trend and analysis reporting, production curves, optimization graphs, and\ncomparative analysis reports are a simple point-and-click away.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SSI's WindCapture™ systems provide real-time reporting with the highest degree of\naccuracy. Trend and analysis reporting, production curves, optimization graphs, and\ncomparative analysis reports are a simple point-and-click away.",
      "lineHeight": 1.4
    },
