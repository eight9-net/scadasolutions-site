    {
      "id": "scada_proj_b1",
      "type": "text",
      "x": 80,
      "y": 1520,
      "width": 1280,
      "height": 43,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 182,
      "version": 1,
      "versionNonce": 183,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The Lalamilo Wind Farm integrates the Wind Energy produced on site to meet the power requirements\nneeded to operate and monitor the various Department of Water Supply resources in the area.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Lalamilo Wind Farm integrates the Wind Energy produced on site to meet the power requirements\nneeded to operate and monitor the various Department of Water Supply resources in the area.",
      "lineHeight": 1.4
    },
    {
      "id": "scada_proj_b2",
      "type": "text",
      "x": 80,
      "y": 1570,
      "width": 1280,
      "height": 43,
      "angle": 0,
