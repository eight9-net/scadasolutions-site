      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Our project management program ensures project completion through all phases of research, design, development,\nconstruction, and deployment. Our team is always available and covers:",
