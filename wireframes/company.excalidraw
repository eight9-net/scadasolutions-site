      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Company Profile",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Company Profile",
      "lineHeight": 1.4
    },
    {
      "id": "cp_b1",
      "type": "text",
      "x": 736,
      "y": 446,
      "width": 688,
      "height": 116,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 136,
      "version": 1,
      "versionNonce": 137,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "SCADA Solutions specializes in restoring infrastructure integrity through the integration of\ncommunications and SCADA systems. We provide complete design, engineering, installation,\nand service of communications and SCADA systems, fiber optics, and cable assemblies, and\nwe offer the latest technologies in smart packet radios. The results are a completely\nintegrated control design essential to the utilization and maintenance of critical\nrenewable energy assets.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SCADA Solutions specializes in restoring infrastructure integrity through the integration of\ncommunications and SCADA systems. We provide complete design, engineering, installation,\nand service of communications and SCADA systems, fiber optics, and cable assemblies, and\nwe offer the latest technologies in smart packet radios. The results are a completely\nintegrated control design essential to the utilization and maintenance of critical\nrenewable energy assets.",
      "lineHeight": 1.4
    },
    {
      "id": "cp_b2",
      "type": "text",
      "x": 736,
      "y": 568,
      "width": 688,
      "height": 97,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 138,
      "version": 1,
      "versionNonce": 139,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Our expertise in system design engineering of complete SCADA solutions, coupled with our\nexperienced and professional installation knowledge, allows for seamless delivery and\nimplementation with minimal operational interruption. Our superior communication,\nautomation, and integration capabilities and ability to serve all brands of turbines,\nboth old and new, set us apart from other third-party SCADA providers.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our expertise in system design engineering of complete SCADA solutions, coupled with our\nexperienced and professional installation knowledge, allows for seamless delivery and\nimplementation with minimal operational interruption. Our superior communication,\nautomation, and integration capabilities and ability to serve all brands of turbines,\nboth old and new, set us apart from other third-party SCADA providers.",
      "lineHeight": 1.4
    },
    {
      "id": "cp_b3",
      "type": "text",
      "x": 736,
      "y": 694,
      "width": 688,
      "height": 79,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 140,
      "version": 1,
      "versionNonce": 141,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Optimal production goals place increased demand on accurate fault detection, consistent\ndata collection and trending, secure remote access, and other industry challenges.\nSSI's wide array of scalable and automated solutions builds reliability and accuracy\ninto your new or existing cyber infrastructure.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Optimal production goals place increased demand on accurate fault detection, consistent\ndata collection and trending, secure remote access, and other industry challenges.\nSSI's wide array of scalable and automated solutions builds reliability and accuracy\ninto your new or existing cyber infrastructure.",
      "lineHeight": 1.4
    },
    {
      "id": "cp_b4",
      "type": "text",
      "x": 736,
      "y": 806,
      "width": 688,
      "height": 43,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 142,
      "version": 1,
      "versionNonce": 143,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The explosive growth in wind energy validates the ongoing wide-scale adoption of this\nlegitimate alternative to traditional energy sources. Let SCADA Solutions provide the answers.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The explosive growth in wind energy validates the ongoing wide-scale adoption of this\nlegitimate alternative to traditional energy sources. Let SCADA Solutions provide the answers.",
      "lineHeight": 1.4
    },
