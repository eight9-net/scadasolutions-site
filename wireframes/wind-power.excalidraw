      "versionNonce": 299,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The theoretical maximum amount of energy that a perfect wind turbine can extract — 59% of wind kinetic energy.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The theoretical maximum amount of energy that a perfect wind turbine can extract — 59% of wind kinetic energy.",
      "lineHeight": 1.4
    },
    {
      "id": "gloss_term3",
      "type": "text",
      "x": 80,
