      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Betz limit:",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Betz limit:",
      "lineHeight": 1.4
    },
    {
      "id": "gloss_def2",
      "type": "text",
      "x": 80,
      "y": 3744,
      "width": 620,
      "height": 23,
      "angle": 0,
