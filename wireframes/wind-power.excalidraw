      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Annual Energy Production:",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Annual Energy Production:",
      "lineHeight": 1.4
    },
    {
      "id": "gloss_def0",
      "type": "text",
      "x": 80,
      "y": 3656,
      "width": 620,
      "height": 23,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 290,
      "version": 1,
      "versionNonce": 291,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "The calculated or measured energy delivered by a wind turbine generator (WTG).",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The calculated or measured energy delivered by a wind turbine generator (WTG).",
      "lineHeight": 1.4
    },
    {
      "id": "gloss_term1",
      "type": "text",
      "x": 80,
      "y": 3682,
      "width": 620,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
