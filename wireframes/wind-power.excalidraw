      "versionNonce": 293,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Alternating current (AC):",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Alternating current (AC):",
      "lineHeight": 1.4
    },
    {
      "id": "gloss_def1",
      "type": "text",
      "x": 80,
      "y": 3700,
      "width": 620,
      "height": 23,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 294,
      "version": 1,
      "versionNonce": 295,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "An electrical current whose direction reverses periodically, usually many times per second.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An electrical current whose direction reverses periodically, usually many times per second.",
      "lineHeight": 1.4
    },
    {
      "id": "gloss_term2",
      "type": "text",
      "x": 80,
      "y": 3726,
      "width": 620,
