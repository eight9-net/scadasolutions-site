      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "What is a Wind Turbine, and how does it work?",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is a Wind Turbine, and how does it work?",
      "lineHeight": 1.4
    },
    {
      "id": "s2_b1",
      "type": "text",
      "x": 16,
      "y": 832,
      "width": 688,
      "height": 61,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 152,
      "version": 1,
      "versionNonce": 153,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "A wind energy system transforms the kinetic energy of the wind into mechanical or electrical\nenergy that can be harnessed for practical use. Mechanical energy is most commonly used\nfor pumping water in rural or remote locations.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A wind energy system transforms the kinetic energy of the wind into mechanical or electrical\nenergy that can be harnessed for practical use. Mechanical energy is most commonly used\nfor pumping water in rural or remote locations.",
      "lineHeight": 1.4
    },
    {
