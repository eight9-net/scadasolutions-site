      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "SCADA Solutions is currently looking for talented, highly motivated, and dependable\nsoftware engineers (junior and experienced) to join our team in the San Diego area.\nThis is your chance to work with some of the brightest SCADA engineers in the land.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SCADA Solutions is currently looking for talented, highly motivated, and dependable\nsoftware engineers (junior and experienced) to join our team in the San Diego area.\nThis is your chance to work with some of the brightest SCADA engineers in the land.",
      "lineHeight": 1.4
    },
