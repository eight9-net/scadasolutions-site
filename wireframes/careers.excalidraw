    {
      "id": "na_j2_intro",
      "type": "text",
      "x": 736,
      "y": 1352,
      "width": 688,
      "height": 61,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 166,
      "version": 1,
      "versionNonce": 167,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "SCADA Solutions is currently looking for talented, highly motivated, and dependable\nfield technicians (junior and experienced) to join our team in the San Diego area.\nThis is your chance to work in one of the fastest-growing industries: renewable energy.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SCADA Solutions is currently looking for talented, highly motivated, and dependable\nfield technicians (junior and experienced) to join our team in the San Diego area.\nThis is your chance to work in one of the fastest-growing industries: renewable energy.",
      "lineHeight": 1.4
    },
    {
      "id": "na_j2_r_h",
      "type": "text",
      "x": 736,
      "y": 1420,
      "width": 688,
      "height": 27,
      "angle": 0,
      "strokeColor": "#60a5fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 168,
      "version": 1,
      "versionNonce": 169,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Responsibilities",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Responsibilities",
      "lineHeight": 1.4
    },
    {
      "id": "na_j2_r_body",
      "type": "text",
      "x": 736,
      "y": 1448,
      "width": 688,
      "height": 97,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 170,
      "version": 1,
      "versionNonce": 171,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "You will be directly involved in our cutting-edge SCADA system architecture and\nconfiguration. Work encompasses testing, simulating, installing, and servicing our\ncommunications and SCADA software solution networks. You will be traveling to wind\nfarm projects around the country about 30% of the time. Your involvement will include\nproject management, server configuration, troubleshooting, and technical support.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You will be directly involved in our cutting-edge SCADA system architecture and\nconfiguration. Work encompasses testing, simulating, installing, and servicing our\ncommunications and SCADA software solution networks. You will be traveling to wind\nfarm projects around the country about 30% of the time. Your involvement will include\nproject management, server configuration, troubleshooting, and technical support.",
      "lineHeight": 1.4
    },
