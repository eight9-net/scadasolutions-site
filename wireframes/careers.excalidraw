    {
      "id": "phero_sub",
      "type": "text",
      "x": 280,
      "y": 366,
      "width": 880,
      "height": 163,
      "angle": 0,
      "strokeColor": "#d1d5db",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
