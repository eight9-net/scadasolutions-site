      "boundElements": null,
      "updated": 1708800000000,
      "link": null,
      "locked": false,
      "text": "Want to help change the world? Become a member of the exciting, dynamic, and\nchallenging world of renewable energy. SCADA Solutions specializes in restoring\ninfrastructure integrity through the integration of communications and SCADA systems.\nOur products and services are as good as our winning teams, who design, engineer,\nintegrate, install, and service them. Please check back regularly or contact our\nHuman Resources Department for opportunities. Come and grow with us; together,\nwe can make a difference.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Want to help change the world? Become a member of the exciting, dynamic, and\nchallenging world of renewable energy. SCADA Solutions specializes in restoring\ninfrastructure integrity through the integration of communications and SCADA systems.\nOur products and services are as good as our winning teams, who design, engineer,\nintegrate, install, and service them. Please check back regularly or contact our\nHuman Resources Department for opportunities. Come and grow with us; together,\nwe can make a difference.",
      "lineHeight": 1.4
    },
